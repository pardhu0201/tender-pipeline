# Copy to .env and adjust. Real environment variables always win over this file.

# --- Database ----------------------------------------------------------------
# `docker compose up -d db` publishes Postgres on localhost:5433 (not 5432, so it
# never collides with a Postgres already installed on your machine).
DATABASE_URL=postgresql://tender:tender@localhost:5433/tenders

# Test suite only. The tests DROP AND RECREATE the tables in this database,
# so never point it at real data. docker compose creates `tenders_test` for you.
# TEST_DATABASE_URL=postgresql://tender:tender@localhost:5433/tenders_test

# Password for the docker compose database (change it on a server).
# POSTGRES_PASSWORD=tender

# --- Crawling -------------------------------------------------------------------
# Minimum seconds between requests to GeM. The code refuses anything below 0.5.
REQUEST_DELAY_SECONDS=1.0
HTTP_TIMEOUT_SECONDS=30
MAX_RETRIES=4

# Incremental runs re-read this many hours before the previous run started
# (catches bids that appear late), and stop after this many consecutive pages
# older than that.
INCREMENTAL_OVERLAP_HOURS=6
INCREMENTAL_STOP_AFTER_PAGES=3

# Identify the crawler honestly; point the URL at your own repository.
# USER_AGENT=Mozilla/5.0 (compatible; tender-pipeline/0.1; +https://github.com/<you>/tender-pipeline)

# --- Operations ---------------------------------------------------------------
# Optional Slack-compatible incoming webhook for failures, degraded runs and
# stale data. For Discord, append /slack to the webhook URL.
ALERT_WEBHOOK_URL=

LOG_LEVEL=INFO
